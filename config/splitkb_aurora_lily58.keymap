#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            //hold-trigger-key-positions = < ... >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            //hold-trigger-key-positions = < ... >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };
    
    macros {
         alt_f4_m: alt_f4 {  // use it with &alt_f4_m
            compatible = "zmk,behavior-macro";
            label = "Alt F4 Macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp F4>,
                       <&macro_release &kp LALT>;
        };
        alt_tab_m: alt_tab {  // use it with &alt_tab_m
            compatible = "zmk,behavior-macro";
            label = "Alt TAB Macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp TAB>,
                       <&macro_release &kp LALT>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };
    
    keymap {
        compatible = "zmk,keymap";

        l0_layer {
            display-name = "BASE";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  BSPC |
// |   `   |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// |  TAB  |  Z  |  X  |  C   |  V   |  B   |        |  |       |  N   |  M    |  ,    |  .   |   /   |   \   |
//                     |      | LCTRL|  M1  |  SPACE |  | ENTER |  M2  |  M3   |       |
            bindings = <
&trans      &trans      &trans        &trans        &trans         &trans                                &trans      &trans        &trans       &trans        &trans         &trans
&kp ESC     &kp Q       &kp W         &kp E         &kp R          &kp T                                 &kp Y       &kp U         &kp I        &kp O         &kp P          &kp BSPC
&kp GRAVE   &hml LGUI A &hml LALT S   &hml LCTRL D  &hml LSHIFT F  &kp G                                 &kp H       &hmr RSHIFT J &hmr RCTRL K &hmr RALT L   &hmr RGUI SEMI &kp SQT
&kp TAB     &kp Z       &kp X         &kp C         &kp V          &kp B       &trans        &trans      &kp N       &kp M         &kp COMMA    &kp DOT       &kp FSLH       &kp BSLH
                                      &trans        &kp LCTRL      &mo 1       &kp SPACE     &kp RET     &mo 2         &mo 3       &trans
            >;
        };

        l1_layer {
            display-name = "L1";
// ------------------------------------------------------------------------------------------------------------
// |       |      |      |       |        |      |                   |      |       |       |       |       |       |
// |ALT F4 |  F1  |  F2  |  F3   |  F4    |  F5  |                   |  6   |   7   |   8   |  9    |   0   |  DEL  |
// |       | LGUI | LALT | LCTRL | LSHIFT |      |                   | LEFT | DOWN  |  UP   | RIGHT |  INS  |       |
// |       |      |      |       |        |      |        |  |       | HOME | PG_DN | PG_UP | END   |   -   |   =   |
//                       |       |        |      |        |  |  DEL  |  M2  |  M3   |       |
            bindings = <
&trans     &trans     &trans           &trans            &trans           &trans                       &trans    &trans      &trans    &trans    &trans         &trans
&alt_f4_m  &kp F1     &kp F2           &kp F3            &kp F4           &kp F5                       &kp N6    &kp N7      &kp N8    &kp N9    &kp N0         &kp DEL
&trans     &kp LGUI   &kp LALT         &kp LCTRL         &kp LSHIFT       &trans                       &kp LEFT  &kp DOWN    &kp UP    &kp RIGHT &kp INS        &trans
&trans     &trans     &trans           &kp CAPS          &trans           &trans     &trans &trans     &kp HOME  &kp PG_DN   &kp PG_UP &kp END   &kp MINUS      &kp EQUAL
                                       &trans            &trans           &trans     &trans &kp DEL    &mo 2     &kp LSHIFT  &trans
            >;
        };

        l2_layer {
            display-name = "L2";
// ------------------------------------------------------------------------------------------------------------
// |       |          |      |        |        |      |                   |        |       |       |       |       |       |
// |  RET  |   1      |   2  |   3    |   4    |   5  |                   |  F6    |  F7   |  F8   | F9    |  F10  |       |
// |   "{" |  "["     |   (  |   )    |  "]"   |  "}" |                   |        |RSHIFT | RCTRL | RALT  | RGUI  |  F11  |
// |  CAPS | F20 (MIC)|C_MUTE|C_VOL_DN|C_VOL_UP|PSCRN |        |  |       |        |       |       |       |       |  F12  |
//                    |      |        |        |  M1  | BSPC   |  |       |        |       |       |
            bindings = <
&trans     &trans     &trans           &trans            &trans           &trans                       &trans     &trans      &trans    &trans    &trans      &trans
&kp RET    &kp N1     &kp N2           &kp N3            &kp N4           &kp N5                       &kp F6     &kp F7      &kp F8    &kp F9    &kp F10     &trans
&kp LBRC   &kp LBKT   &kp LPAR         &kp RPAR          &kp RBKT         &kp LBRC                     &trans     &kp RSHIFT  &kp RCTRL &kp RALT  &kp RGUI    &kp F11
&kp CAPS   &kp F20    &kp C_MUTE       &kp C_VOL_DN      &kp C_VOL_UP     &kp PSCRN &trans   &trans    &trans     &trans      &trans    &trans    &trans      &kp F12
                                       &trans            &trans           &mo 1     &kp BSPC &trans    &trans     &trans      &trans
            >;
        };


        l3_layer {
            display-name = "L3";
// -----------------------------------------------------------------------------------------------------------
// |       |         |        |        |        |      |                   |      |       |        |         |       |       |
// | BTCLR | BT1     | BT2    |  BT3   |  BT4   |  BT5 |                   |      |       |        |         |       |       |
// |       |         |        |        |        |      |                   | LEFT | DOWN  |  UP    | RIGHT   |  INS  |       |
// |       |F20 (MIC)|C_MUTE  |C_VOL_DN|C_VOL_UP|PSCRN |        |  |       | HOME | PG_DN | PG_UP  | END     |       |       |
//                   |        |        |        |      |        |  |       |      |       |        |
            bindings = <
&trans        &trans          &trans          &trans          &trans          &trans                             &trans    &trans     &trans        &trans    &trans    &trans
&bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                       &trans    &trans     &trans        &trans    &trans    &trans
&trans        &trans          &trans          &trans          &trans          &trans                             &kp LEFT  &kp DOWN   &kp UP        &kp RIGHT &kp INS   &trans
&trans        &kp F20         &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp PSCRN     &trans   &trans      &kp HOME  &kp PG_DN  &kp PG_UP     &kp END   &trans    &trans
                                              &trans          &trans          &trans        &trans   &trans      &trans    &trans     &trans
            >;
        };

        l4_layer {
            display-name = "L12";
// ------------------------------------------------------------------------------------------------------------
// |       |      |      |       |        |      |                   |      |       |       |       |       |       |
// | RET   |   1  |   2  |   3   |   4    |   5  |                   |  6   |   7   |   8   |  9    |   0   |  DEL  |
// |       |      |      |       |        |      |                   | LEFT | DOWN  |  UP   | RIGHT |       |       |
// |       |      |      |       |        |      |                   |      |       |   ,   |  .    |   -   |  =    |
//                       |       |        |      |        |  |       |      |       |       |
            bindings = <
&trans     &trans     &trans           &trans            &trans           &trans                       &trans    &trans      &trans    &trans    &trans         &trans
&kp RET    &kp N1     &kp N2           &kp N3            &kp N4           &kp N5                       &kp N6    &kp N7      &kp N8    &kp N9    &kp N0         &kp DEL
&trans     &trans     &trans           &trans            &trans           &trans                       &kp LEFT  &kp DOWN    &kp UP    &kp RIGHT &trans         &trans
&trans     &trans     &trans           &trans            &trans           &trans     &trans &trans     &trans    &trans      &kp COMMA &kp DOT   &kp MINUS      &kp EQUAL
                      &trans           &trans            &trans           &trans                       &trans    &trans      &trans    &trans
            >;  
        };
    };
};
